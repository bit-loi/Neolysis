# ============================================================
# Neolysis Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# ── PostgreSQL via Supabase (native asyncpg — NOT Supabase SDK) ────────────
# Option A: Use individual SUPABASE_DB_* vars (recommended for Supabase)
SUPABASE_DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PORT=5432

# Option B: Use a full DATABASE_URL (overrides Option A if set)
# DATABASE_URL=postgresql+asyncpg://postgres:password@host:5432/postgres

# ── Redis Cache ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Google GenAI (Gemma 4) ─────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-genai-api-key
LLM_MODEL_NAME=gemma-4-27b-it

# Training-free protein representation. Keep "baseline" for lightweight local use,
# or set "esm2" to lazily load the pretrained Hugging Face model.
PROTEIN_EMBEDDING_MODE=baseline
PROTEIN_EMBEDDING_MODEL=facebook/esm2_t6_8M_UR50D
PROTEIN_EMBEDDING_MAX_RESIDUES=1022

# ── Qdrant Vector Store ────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Security ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Cloudflare R2 (optional, for PDB file hosting) ────────────────────────
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# ── App ────────────────────────────────────────────────────────────────────
DEBUG=false
