# ============================================================
# Neolysis Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# Option B: Use a full DATABASE_URL (overrides Option A if set)
# DATABASE_URL=postgresql+asyncpg://postgres:password@host:5432/postgres

# ── Redis Cache ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Google GenAI (Gemma 4) ─────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-genai-api-key
LLM_MODEL_NAME=gemma-4-27b-it

# Training-free protein representation. Keep "baseline" for lightweight local use,
# or set "esm2" to call the dedicated PLM inference microservice (services/plm-inference).
# This backend never loads ESM2 in its own process.
PROTEIN_EMBEDDING_MODE=baseline
PROTEIN_EMBEDDING_MODEL=facebook/esm2_t30_150M_UR50D
PROTEIN_EMBEDDING_MAX_RESIDUES=1022

# ── PLM Inference Microservice (services/plm-inference) ───────────────────
# Only used when PROTEIN_EMBEDDING_MODE=esm2. Leave PLM_SERVICE_URL empty to
# keep using the baseline embedding provider.
PLM_SERVICE_URL=
PLM_POOLING=mean
# Optional: only needed for gated/private Hugging Face models, not public ESM2.
HF_TOKEN=

# ── NVIDIA NIM (structure prediction / MSA / ProteinMPNN) ──────────────────
# Leave NVIDIA_API_KEY empty to keep structure endpoints disabled (they return
# a clear "not configured" error). Never commit a real key.
NVIDIA_API_KEY=
NVIDIA_HEALTH_API_BASE_URL=
NVIDIA_DEFAULT_STRUCTURE_MODEL=openfold3
NVIDIA_REQUEST_TIMEOUT_SECONDS=900

# ── Qdrant Vector Store ────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Security ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Cloudflare R2 (optional, for PDB file hosting) ────────────────────────
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# ── App ────────────────────────────────────────────────────────────────────
DEBUG=false
